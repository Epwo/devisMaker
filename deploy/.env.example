# Copier en .env puis renseigner. (Commentaires sur des lignes à part : docker compose ne lit pas les fins de ligne.)

# ---------------------------------------------------------------- image
DEVIS_IMAGE=docker.io/CHANGER/devismaker
# Version publiée (défaut : latest)
# APP_VERSION=0.3.0
# APP_PORT=8000

# ---------------------------------------------------------------- base de données (obligatoire)
# Éviter @ : / ? # dans le mot de passe (il est placé tel quel dans l'URL de connexion).
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- clés API (facultatives)
# Sans clé : OCR local seul, sans IA (gratuit, hors ligne, moins de champs trouvés).
# Claude : compréhension du plan (IA par défaut). CLAUDE_API_KEY ou ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
# Mistral : lecture « planche » (repérage local + Mistral OCR) et IA de repli.
MISTRAL_API_KEY=

# ---------------------------------------------------------------- journaux
# DEBUG | INFO | WARNING | ERROR
# DEVIS_LOG_LEVEL=INFO
