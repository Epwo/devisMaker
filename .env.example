# Copier en .env puis renseigner. Les lignes commentées donnent la valeur par défaut.
# (Commentaires sur des lignes à part : docker compose ne lit pas les commentaires en fin de ligne.)

# ---------------------------------------------------------------- clés API
# Claude : compréhension du plan (IA par défaut). CLAUDE_API_KEY ou ANTHROPIC_API_KEY.
CLAUDE_API_KEY=
# Mistral : OCR « planche » (repérage local + lecture Mistral OCR) et IA de repli.
MISTRAL_API_KEY=

# ---------------------------------------------------------------- lecture du plan (OCR)
# auto = mistral_board si MISTRAL_API_KEY, sinon rapid_v4 (local, gratuit, hors ligne).
# Autres : ppocr_v5 | ppocr_v5_srv | mistral
# DEVIS_OCR_ENGINE=auto
# DEVIS_MISTRAL_OCR_MODEL=mistral-ocr-latest
# Confiance OCR en dessous de laquelle une lecture est envoyée à l'IA
# DEVIS_OCR_CONF_THRESHOLD=0.85

# ---------------------------------------------------------------- IA (compréhension du plan)
# pointage : l'IA désigne les textes lus, la valeur vient de l'OCR (meilleur au banc d'essai) | lecture
# DEVIS_VLM_STRATEGY=pointage
# auto = Claude si clé, sinon Mistral ; bascule sur l'autre en cas d'échec (crédit, réseau…)
# DEVIS_VLM_PROVIDER=auto
# DEVIS_VLM_MODEL=claude-haiku-5-5
# low | medium | high (low suffit en « pointage »)
# DEVIS_VLM_EFFORT=low
# « a+b » = consensus : une valeur n'est gardée que si les modèles s'accordent
# DEVIS_MISTRAL_VLM_MODEL=mistral-small-latest+ministral-14b-latest
# Taille max (px) de l'image envoyée à l'IA
# DEVIS_VLM_IMAGE_MAX_SIDE=2400
# Cache disque des réponses IA (.cache/vlm) : 0 pour le désactiver
# DEVIS_VLM_CACHE=1
# 1 = envoyer aussi les vues agrandies (n'aide pas les modèles testés)
# DEVIS_MARKS_VIEW_CROPS=0

# ---------------------------------------------------------------- base de données
# Sans Docker : SQLite par défaut (data/devismaker.db), rien à configurer. PostgreSQL :
# DATABASE_URL=postgresql+psycopg://devis:motdepasse@localhost:5432/devismaker
# Avec docker compose : mot de passe OBLIGATOIRE (DATABASE_URL est construite par docker-compose.yml).
# Éviter @ : / ? # dans le mot de passe (il est placé tel quel dans l'URL de connexion).
POSTGRES_PASSWORD=
# POSTGRES_USER=devis
# POSTGRES_DB=devismaker
# APP_PORT=8000
# 0 = ne pas garder les plans ni les décisions de l'utilisateur (journal d'apprentissage)
# DEVIS_LEARNING=1

# ---------------------------------------------------------------- journaux
# DEBUG | INFO | WARNING | ERROR
# DEVIS_LOG_LEVEL=INFO
# DEVIS_LOG_FILE=data/logs/devismaker.log
